{
  "name": "vault-pulse",
  "version": "0.1.0",
  "description": "Live activity timeline for Obsidian vaults with optional read-only Git status.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run --passWithNoTests"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "activity",
    "timeline",
    "git"
  ],
  "author": "Alek",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  }
}
